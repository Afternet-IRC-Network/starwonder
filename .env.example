# Copy to .env and adjust. Server reads these (see apps/server/src/env.ts).
NODE_ENV=development
PORT=8080

# SQLite file (swap for a Postgres URL later — see apps/server/src/db).
DATABASE_FILE=./data/starwonder.sqlite

# Shared registration gate. Anyone with this password may create an account (MVP).
GATE_PASSWORD=afternet

# Secret for signing session cookies. Use a long random string in production.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Default universe created on first boot if none exists.
DEFAULT_SEED=aurora
