# Copy to .env and adjust. Server reads these (see apps/server/src/env.ts).
NODE_ENV=development
PORT=8080

# SQLite file (swap for a Postgres URL later — see apps/server/src/db).
DATABASE_FILE=./data/starwonder.sqlite

# Shared registration gate. Anyone with this password may create an account (MVP).
GATE_PASSWORD=afternet

# Secret for signing session cookies. Use a long random string in production.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Default universe created on first boot if none exists.
DEFAULT_SEED=aurora

# Set to true only when TLS is terminated upstream (nginx/Caddy in front of the container).
# Must be false when serving over plain HTTP, or the session cookie will be silently dropped.
COOKIE_SECURE=false

# Shared secret for the IRC bot's /api/bot/* endpoints (set the same value for both
# the server and the bot containers). Use a long random string in production.
BOT_TOKEN=dev-bot-token-change-me

# IRC bot (apps/bot) — the town crier in #starwonder on AfterNET.
IRC_SERVER=irc.afternet.org
IRC_PORT=6667
IRC_TLS=false
IRC_NICK=StarWonder
IRC_CHANNEL=#starwonder
POLL_SECONDS=90

# Claude API key for the idle narrator (not used yet — until set, the dock screen shows
# the exact prompt that WOULD be sent; see apps/server/src/narrator.ts).
#ANTHROPIC_API_KEY=
