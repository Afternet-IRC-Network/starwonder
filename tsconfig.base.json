{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "sourceMap": true,
    "declaration": false,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@starwonder/game-core": ["packages/game-core/src/index.ts"],
      "@starwonder/shared": ["packages/shared/src/index.ts"]
    }
  }
}
