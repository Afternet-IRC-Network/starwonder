{
  "name": "starwonder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm --filter @starwonder/web run build",
    "start": "pnpm --filter @starwonder/server run start",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck"
  }
}
